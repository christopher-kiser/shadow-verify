            {
              "property": "pab.ignore_public_acls",
              "op": "eq",
              "value": true
            },
            {
              "property": "pab.block_public_policy",
              "op": "eq",
              "value": true
            },
            {
              "property": "pab.restrict_public_buckets",
              "op": "eq",
              "value": true
            }
          ]
        }
      ]
