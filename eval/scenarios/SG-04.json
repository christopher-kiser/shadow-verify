{
  "id": "SG-04",
  "resource_type": "security_group",
  "agent_claim": {
    "text": "Done: opened tcp 443 from 0.0.0.0/0 and from ::/0 on the web security group.",
    "structured": {
      "resources": [
        {
          "resource_type": "security_group",
          "resource_id": "${sg}",
          "region": "us-east-1",
          "account_id": null,
          "assertions": [
            {
              "property": "ingress",
              "op": "contains",
              "value": {
                "protocol": "tcp",
                "from_port": 443,
                "to_port": 443,
                "cidr": "0.0.0.0/0"
              }
            },
            {
              "property": "ingress",
              "op": "contains",
              "value": {
                "protocol": "tcp",
                "from_port": 443,
                "to_port": 443,
                "cidr": "::/0"
              }
            }
          ]
        }
      ]
    },
    "prose_assertions": "same"
  },
  "seed": {
    "region": "us-east-1",
    "steps": [
      {
        "call": "ec2.create_vpc",
        "params": {
          "CidrBlock": "10.0.0.0/16"
        },
        "save": {
          "vpc": "Vpc.VpcId"
        }
      },
      {
        "call": "ec2.create_security_group",
        "params": {
          "GroupName": "sg-web",
          "Description": "sg-web",
          "VpcId": "${vpc}"
        },
        "save": {
          "sg": "GroupId"
        }
      },
      {
        "call": "ec2.authorize_security_group_ingress",
        "params": {
          "GroupId": "${sg}",
          "IpPermissions": [
            {
              "IpProtocol": "tcp",
              "FromPort": 443,
              "ToPort": 443,
              "IpRanges": [
                {
                  "CidrIp": "0.0.0.0/0"
                }
              ]
            }
          ]
        }
      }
    ],
    "post_claim": [],
    "fault": [],
    "page_size": null
  },
  "condition": "none",
  "failure_type": "silent_partial_apply",
  "na_cause": null,
  "expected_verdict": "FAIL",
  "expected_raw_verdict": "FAIL",
  "claim_true": false,
  "stretch": false,
  "rationale": "Tcp 443 is open from 0.0.0.0/0 and not from ::/0, so only half of the claim landed."
}
