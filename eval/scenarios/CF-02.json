{
  "id": "CF-02",
  "resource_type": "security_group",
  "agent_claim": {
    "text": "Done: only tcp 443 from 0.0.0.0/0 is open on the web security group, and tcp 22 was removed.",
    "structured": {
      "resources": [
        {
          "resource_type": "security_group",
          "resource_id": "${sg}",
          "region": "us-east-1",
          "account_id": null,
          "assertions": [
            {
              "property": "ingress",
              "op": "contains",
              "value": {
                "protocol": "tcp",
                "from_port": 443,
                "to_port": 443,
                "cidr": "0.0.0.0/0"
              }
            }
          ]
        }
      ]
    },
    "prose_assertions": [
      {
        "resource_id": "${sg}",
        "property": "ingress",
        "op": "contains",
        "value": {
          "protocol": "tcp",
          "from_port": 443,
          "to_port": 443,
          "cidr": "0.0.0.0/0"
        }
      },
      {
        "resource_id": "${sg}",
        "property": "ingress",
        "op": "not_contains",
        "value": {
          "protocol": "tcp",
          "from_port": 22,
          "to_port": 22,
          "cidr": "0.0.0.0/0"
        }
      },
      {
        "resource_id": "${sg}",
        "property": "ingress",
        "op": "equals_set",
        "value": [
          {
            "protocol": "tcp",
            "from_port": 443,
            "to_port": 443,
            "cidr": "0.0.0.0/0"
          }
        ]
      }
    ]
  },
  "seed": {
    "region": "us-east-1",
    "steps": [
      {
        "call": "ec2.create_vpc",
        "params": {
          "CidrBlock": "10.0.0.0/16"
        },
        "save": {
          "vpc": "Vpc.VpcId"
        }
      },
      {
        "call": "ec2.create_security_group",
        "params": {
          "GroupName": "sg-web",
          "Description": "sg-web",
          "VpcId": "${vpc}"
        },
        "save": {
          "sg": "GroupId"
        }
      },
      {
        "call": "ec2.authorize_security_group_ingress",
        "params": {
          "GroupId": "${sg}",
          "IpPermissions": [
            {
              "IpProtocol": "tcp",
              "FromPort": 443,
              "ToPort": 443,
              "IpRanges": [
                {
                  "CidrIp": "0.0.0.0/0"
                }
              ]
            },
            {
              "IpProtocol": "tcp",
              "FromPort": 22,
              "ToPort": 22,
              "IpRanges": [
                {
                  "CidrIp": "0.0.0.0/0"
                }
              ]
            }
          ]
        }
      }
    ],
    "post_claim": [],
    "fault": [],
    "page_size": null
