            {
              "property": "ingress",
              "op": "contains",
              "value": {
                "protocol": "tcp",
                "from_port": 22,
                "to_port": 22,
                "cidr": "10.0.0.0/8"
              }
            },
            {
              "property": "ingress",
              "op": "not_contains",
              "value": {
                "protocol": "tcp",
                "from_port": 22,
                "to_port": 22,
